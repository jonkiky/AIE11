# Copy this file to `.env` in THIS folder:
#     cp .env.example .env
#
# `.env` is gitignored, so your real key is never committed.
# The app loads it automatically via python-dotenv.

# Models run locally through LiteLLM -> Ollama:
# ollama pull qwen3-embedding:0.6b
# ollama pull qwen3:4b-instruct
# Point this at a different Ollama host if it is not on the default port.
LLM_API_BASE=http://localhost:11434
